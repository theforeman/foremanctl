---
:katello:
  :rest_client_timeout: 3600

{% if air_gapped | bool %}
  # Disable subscription connection in air-gapped mode
  :subscription_connection_enabled: false
{% endif %}

  :candlepin:
    :url: https://localhost:23443/candlepin
    :oauth_key: "katello"
    :oauth_secret: "{{ candlepin_oauth_secret }}"
    :ca_cert_file: /etc/foreman/katello-default-ca.crt

  :pulp:
    :ca_cert_file: /etc/foreman/katello-default-ca.crt
