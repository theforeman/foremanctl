#!/usr/bin/env bash

OBSAH_NAME=$(basename "$0")
OBSAH_BASE=$(dirname "$(readlink -f "$0")")
OBSAH_DATA=${OBSAH_BASE}/src
OBSAH_INVENTORY=${OBSAH_BASE}/inventories
OBSAH_STATE=${OBSAH_BASE}/.var/lib/foremanctl
OBSAH_PERSIST_PARAMS=true
# Let downstream wrappers pass extra obsah vars when needed
# (default stays strict; opt-in via OBSAH_ALLOW_EXTRA_VARS=true in env).
OBSAH_ALLOW_EXTRA_VARS=${OBSAH_ALLOW_EXTRA_VARS:-false}
export OBSAH_NAME OBSAH_DATA OBSAH_INVENTORY OBSAH_STATE OBSAH_PERSIST_PARAMS OBSAH_ALLOW_EXTRA_VARS

ANSIBLE_LOG_PATH=${OBSAH_BASE}/.var/lib/foremanctl/foremanctl.log
# Prefer bundled collections, but retain packaged system collections when a
# source checkout overlays /usr/share/foremanctl without gitignored build/.
ANSIBLE_COLLECTIONS_PATH=${OBSAH_BASE}/build/collections/foremanctl:${OBSAH_BASE}/collections:/etc/ansible/collections:/usr/share/ansible/collections
ANSIBLE_COLLECTIONS_SCAN_SYS_PATH=false
export ANSIBLE_LOG_PATH ANSIBLE_COLLECTIONS_PATH ANSIBLE_COLLECTIONS_SCAN_SYS_PATH

unset http_proxy HTTP_PROXY https_proxy HTTPS_PROXY

exec obsah "$@"
