# Declare global ARG before FROM so the base image can be dynamically overridden
ARG BASE_IMAGE=quay.io/foreman/foreman:nightly

FROM ${BASE_IMAGE}

ARG CONTAINER_USER=foreman

USER 0
RUN dnf install -y 'dnf*-command(copr)'

# Space-separated Packit project names, each in organization-repository-PR format.
ARG PACKIT_PROJECTS

# Enable every PR repository before resolving the upgrade in one transaction.
# Query exact package versions to limit upgrade targets to the selected PR builds.
RUN set -e && \
    test -n "$PACKIT_PROJECTS" && \
    repo_ids="" && \
    for project in $PACKIT_PROJECTS; do \
        dnf copr enable -y "packit/$project" rhel-10-x86_64 || exit 1; \
        repo_ids="${repo_ids:+$repo_ids,}copr:copr.fedorainfracloud.org:packit:$project"; \
    done && \
    packages="$(dnf -q repoquery --available --repo="$repo_ids" --latest-limit=1 --nevra)" && \
    test -n "$packages" && \
    dnf upgrade -y --best $packages && \
    dnf clean all
USER ${CONTAINER_USER}
