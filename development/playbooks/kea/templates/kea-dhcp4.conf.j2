
{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": []
    },
    "control-sockets": [
      {
        "socket-type": "http",
        "socket-address": "127.0.0.1",
        "socket-port": {{ kea_api_port }}
      }
    ],
    "hooks-libraries": [
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_host_cmds.so"
      },
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib64/kea/hooks/libdhcp_pgsql.so"
      }
    ],
    "subnet4": [
      {
        "id": 1,
        "subnet": "192.168.122.0/24",
        "pools": [
          {
            "pool": "192.168.122.100 - 192.168.122.200"
          }
        ]
      }
    ],
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "hosts-database": {
      "type": "postgresql",
      "name": "kea",
      "user": "kea",
      "password": {{ kea_db_password | to_json }},
      "host": "127.0.0.1",
      "port": {{ kea_db_port }}
    }
  }
}
