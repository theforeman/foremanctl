#!/usr/bin/env bash

OBSAH_NAME=forge
OBSAH_BASE=$(dirname $(readlink -f $0))
OBSAH_DATA=${OBSAH_BASE}/development
OBSAH_INVENTORY=${OBSAH_BASE}/inventories
OBSAH_STATE=${OBSAH_BASE}/.var/lib/foremanctl
OBSAH_PERSIST_PARAMS=true
export OBSAH_NAME OBSAH_DATA OBSAH_INVENTORY OBSAH_STATE OBSAH_PERSIST_PARAMS

# Prefer bundled collections, but retain packaged system collections when a
# source checkout overlays the repository without gitignored build/.
ANSIBLE_COLLECTIONS_PATH=${OBSAH_BASE}/build/collections/forge:${OBSAH_BASE}/collections:/etc/ansible/collections:/usr/share/ansible/collections
ANSIBLE_COLLECTIONS_SCAN_SYS_PATH=false
export ANSIBLE_COLLECTIONS_PATH ANSIBLE_COLLECTIONS_SCAN_SYS_PATH

exec obsah "$@"
